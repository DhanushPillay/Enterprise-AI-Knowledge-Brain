# Enterprise AI Knowledge Brain - Environment Configuration

# Groq API Keys (free tier - console.groq.com)
# Create 3 free accounts to get 3 separate keys for pipeline isolation
GROQ_API_KEY_QUERY=your-groq-api-key-for-user-queries
GROQ_API_KEY_EXTRACTION=your-groq-api-key-for-entity-extraction
GROQ_API_KEY_SECURITY=your-groq-api-key-for-prompt-injection-detection

# Neo4j (local Docker instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ChromaDB (local, no config needed)
CHROMA_PERSIST_DIR=./data/chroma

# Embedding model (local, runs on CPU)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server
API_HOST=0.0.0.0
API_PORT=8000
